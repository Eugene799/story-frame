{
  "rules": [
    {
      "id": "storyframe-studio-origins",
      "allowed": {
        "origins": [
          "http://localhost:3000",
          "https://storyframe-nse9.onrender.com"
        ],
        "methods": [
          "GET",
          "PUT",
          "HEAD"
        ],
        "headers": [
          "Content-Type"
        ]
      },
      "exposeHeaders": [
        "ETag",
        "Content-Length"
      ],
      "maxAgeSeconds": 3600
    }
  ]
}
