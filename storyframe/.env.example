# StoryFrame Phase 2 configuration.
# Copy this file to .env (git-ignored) and fill in values locally.
# Server-only values must never be prefixed with VITE_. The VITE_ values below are
# browser-visible public configuration; never put a secret in them.

# Required: Ollama Cloud API key. Read only inside the Node server process.
# Create one at https://ollama.com/settings/keys
OLLAMA_API_KEY=

# Fixed upstream. The server refuses any other value.
OLLAMA_BASE_URL=https://ollama.com

# Required: Supabase project used for authentication and the usage ledger.
SUPABASE_URL=
# Publishable key (or the legacy anon key) - safe for the client, still read from the server env.
SUPABASE_PUBLISHABLE_KEY=
# Optional alias if you only have the legacy key name:
# SUPABASE_ANON_KEY=

# Browser-visible Supabase Auth configuration for the Vite client.
# Use the same project URL and publishable/anon key as above; never the service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional alias if you use the legacy key name:
# VITE_SUPABASE_ANON_KEY=

# Server-only. Used to write/read the usage ledger; never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Optional auth/ledger request timeout (ms).
AUTH_TIMEOUT_MS=5000

# Apply supabase/migrations/*.sql before using the ledger.

# Private media storage (Phase 3). Cloudflare R2 through its S3 endpoint.
# The bucket stays private; the server issues short-lived presigned URLs.
# CLOUDFLARE_S3_ENDPOINT_URL, CLOUDFLARE_R2_BUCKET_NAME, CLOUDFLARE_ACCESS_ID,
# and CLOUDFLARE_SECRET_ACCESS_KEY are accepted as fallbacks.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional media bounds.
MEDIA_IMAGE_MAX_BYTES=10485760
MEDIA_AUDIO_MAX_BYTES=26214400
MEDIA_VIDEO_MAX_BYTES=209715200
MEDIA_OWNER_STORAGE_BYTES=2147483648
MEDIA_UPLOAD_URL_SECONDS=900
MEDIA_DOWNLOAD_URL_SECONDS=300
MEDIA_UPLOAD_TTL_MS=900000
MEDIA_DELETED_RETENTION_MS=86400000
MEDIA_UNREFERENCED_RETENTION_MS=604800000

# Phase 6: Pexels and Pixabay stock search (server-only keys).
# Create them at https://www.pexels.com/api/ and https://pixabay.com/api/docs/.
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Optional stock bounds. Pixabay requires results to be cached for 24 hours, so
# STOCK_PIXABAY_CACHE_SECONDS is never below 86400.
STOCK_PROVIDER_TIMEOUT_MS=8000
STOCK_PAGE_SIZE=20
STOCK_MAX_PAGE=50
STOCK_QUERY_MAX_CHARS=80
STOCK_PEXELS_CACHE_SECONDS=3600
STOCK_PIXABAY_CACHE_SECONDS=86400
STOCK_CACHE_PAYLOAD_BYTES=262144
STOCK_CACHE_LEASE_MS=15000
STOCK_CACHE_WAIT_MS=2500

STOCK_IMPORT_TIMEOUT_MS=30000
STOCK_IMPORT_REDIRECTS=3

# Phase 7 image generation. Each provider stays disabled until its own values
# exist; a missing provider never falls back to the other.
CLOUDFLARE_ACCOUNT_ID=
# Workers AI token. CF_API_TOKEN is accepted as the same value.
CLOUDFLARE_AI_API_TOKEN=
LEONARDO_API_KEY=
IMAGE_POLL_INTERVAL_MS=1500
IMAGE_GENERATION_TIMEOUT_MS=60000
IMAGE_DOWNLOAD_TIMEOUT_MS=30000

# Server bind address. The Vite dev server proxies /api here.
HOST=127.0.0.1
PORT=8787

# Exact direct-request identifiers, verified against https://ollama.com/api/tags
# on 2026-11-24. Overrides are optional; leave a value empty to keep the default.
OLLAMA_MODEL_DEEPSEEK=deepseek-v4.1-flash
OLLAMA_MODEL_GEMMA=gemma4:31b
OLLAMA_MODEL_GLM=glm-5.3-flash
OLLAMA_MODEL_GPT_OSS=gpt-oss:20b
OLLAMA_MODEL_MINIMAX=minimax-m3.1-flash
# Nemotron 3 Nano has no verified direct-cloud identifier; it stays disabled.
OLLAMA_MODEL_NEMOTRON=

# Bounds (optional).
AI_TIMEOUT_MS=30000
AI_MAX_PROMPT_CHARS=500
AI_MAX_OUTPUT_TOKENS=120
AI_MAX_REQUESTS_PER_MINUTE=6
# Age (ms) after which a pending reservation may be settled as abandoned rather
# than retried. Never applied below the provider timeout plus three auth timeouts.
# Planning uses a wider floor of two provider timeouts plus three auth timeouts
# so its initial call and one repair both fit inside the window.
AI_ABANDON_AFTER_MS=90000

# Optional: restrict the API to one exact browser origin.
APP_ORIGIN=
